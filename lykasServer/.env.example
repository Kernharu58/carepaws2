# --- Core ---
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
# Optional: silences dotenv's promotional stdout tip ("tip: ⌘ suppress logs...")
# on every boot. Uncomment if the noise bothers you in local dev/CI logs.
# DOTENV_CONFIG_QUIET=true

# --- Database ---
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/carepaws

# --- Auth ---
JWT_SECRET=replace_with_32plus_char_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_32plus_char_random_string
JWT_REFRESH_EXPIRES_IN=30d

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_FILE_SIZE=10485760

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
ANDROID_CLIENT_ID=
IOS_CLIENT_ID=

# --- Email (either transport) ---
EMAIL_SERVICE=
EMAIL_USER=
EMAIL_PASSWORD=


# --- Payments ---
PAYMONGO_SECRET_KEY=

# --- Frontends ---
FRONTEND_URL=http://localhost:5173
MOBILE_APP_URL=carepaws://

# --- Production additions (§11) ---
REDIS_URL=redis://localhost:6379
SENTRY_DSN=
LOG_LEVEL=info
